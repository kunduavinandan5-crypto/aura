# Copy to .env (never commit .env). Every VITE_* value is bundled into the browser build,
# so only PUBLIC values belong here. NEVER put a Supabase service_role key or any
# Gemini / Anthropic / OpenAI key in this file - model keys live on your AI backend.

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase anon / publishable key (public by design; protected by Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# URL of your AI/RAG backend. Required in production builds.
VITE_RAG_API_URL="https://your-ai-backend.example.com/api/chat"

# Set to "false" to hide the "Try the demo" button on the login screen.
VITE_ENABLE_DEMO="true"

# Public URL of the deployed site (no trailing slash). Used for canonical URL, Open Graph, sitemap.xml, llms.txt.
VITE_SITE_URL="https://your-domain.example.com"
